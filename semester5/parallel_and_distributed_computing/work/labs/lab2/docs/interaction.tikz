% Структурна схема за принципом рис. 6.2 методичних прикладів:
% задачі, точки синхронізації та реальні засоби, що їх пов'язують.
\begin{tikzpicture}[x=1cm,y=1cm,>=Stealth,font=\small,
 task/.style={draw,thick,trapezium,trapezium left angle=84,
   trapezium right angle=96,fill=yellow!12,minimum width=3.25cm,
   minimum height=6.0cm,align=center},
 resource/.style={draw,ellipse,fill=green!10,align=center,font=\scriptsize},
 point/.style={draw,ellipse,fill=cyan!13,minimum width=1.35cm,
   minimum height=.45cm,align=center,font=\scriptsize},
 signal/.style={point,fill=yellow!28},
 wait/.style={point,fill=cyan!13},
 access/.style={dashed,gray!70,thin}]

\draw[thick] (-.25,-8.0) rectangle (15.55,1.15);
\node[fill=white] at (7.65,1.15)
  {\textbf{Спільна пам’ять і структурна взаємодія потоків}};

\node[resource,minimum width=3.1cm] (console) at (2.0,.35)
  {Консоль, $M_1$\\$CS_{in},CS_{out}$};
\node[resource,minimum width=3.0cm] (minimum) at (7.65,.35)
  {$A_1$: \texttt{min\_b}\\атомарна змінна};
\node[resource,minimum width=3.7cm] (memory) at (13.1,.35)
  {$B,Q,MR,MM,MO,d$\\$V,MX,E$};

\node[task] (t1) at (1.8,-4.25) {};
\node[task] (t2) at (5.7,-4.25) {};
\node[task] (t3) at (9.6,-4.25) {};
\node[task] (t4) at (13.5,-4.25) {};

\node[font=\bfseries] at (1.8,-1.62) {$T_1$};
\node[font=\bfseries] at (5.7,-1.62) {$T_2$};
\node[font=\bfseries] at (9.6,-1.62) {$T_3$};
\node[font=\bfseries] at (13.5,-1.62) {$T_4$};
\node[font=\scriptsize,align=center] at (1.8,-2.10) {введення $MR,Q$\\виведення $E$};
\node[font=\scriptsize,align=center] at (5.7,-2.10) {введення $B,MM$};
\node[font=\scriptsize,align=center] at (9.6,-2.10) {введення $MO,d$};
\node[font=\scriptsize,align=center] at (13.5,-2.10) {без введення};

\foreach \x/\n in {1.8/1,5.7/2,9.6/3,13.5/4}{
  \node[wait] (b1\n) at (\x,-2.85) {$B_1$};
  \node[point,fill=green!13] (a\n) at (\x,-3.75) {$A_1$};
  \node[wait] (b2\n) at (\x,-4.65) {$B_2$};
}

\draw[thick] (b11.east) -- (b12.west);
\draw[thick] (b12.east) -- (b13.west);
\draw[thick] (b13.east) -- (b14.west);
\node[fill=white,font=\tiny] at (3.75,-2.85)
  {$B_1$: \texttt{input\_ready}};

\draw[thick] (a1.east) -- (a2.west);
\draw[thick] (a2.east) -- (a3.west);
\draw[thick] (a3.east) -- (a4.west);
\node[fill=white,font=\tiny] at (3.75,-3.75)
  {$A_1$: \texttt{min\_b}};

\draw[thick] (b21.east) -- (b22.west);
\draw[thick] (b22.east) -- (b23.west);
\draw[thick] (b23.east) -- (b24.west);
\node[fill=white,font=\tiny] at (3.75,-4.65)
  {$B_2$: \texttt{intermediate\_ready}};

\node[wait]   (w2) at (1.8,-5.55) {$W_{2,1}$};
\node[wait]   (w3) at (1.8,-6.25) {$W_{3,1}$};
\node[wait]   (w4) at (1.8,-6.95) {$W_{4,1}$};
\node[signal] (s2) at (5.7,-5.55) {$S_{1,1}$};
\node[signal] (s3) at (9.6,-6.25) {$S_{1,1}$};
\node[signal] (s4) at (13.5,-6.95) {$S_{1,1}$};
\draw[->,thick] (s2.west) -- node[above,font=\scriptsize]
  {$S_1$: \texttt{finished}} (w2.east);
\draw[->,thick] (s3.west) -- node[above,font=\scriptsize]
  {$S_1$: \texttt{finished}} (w3.east);
\draw[->,thick] (s4.west) -- node[above,font=\scriptsize]
  {$S_1$: \texttt{finished}} (w4.east);

\node[font=\scriptsize,align=center] at (5.7,-7.35) {обчислено $E_{J_1}$};
\node[font=\scriptsize,align=center] at (9.6,-7.35) {обчислено $E_{J_2}$};
\node[font=\scriptsize,align=center] at (13.5,-7.35) {обчислено $E_{J_3}$};
\node[font=\scriptsize,align=center] at (1.8,-7.55) {після трьох $W$\\виведення $E$};

\draw[access] (console.south) -- (1.8,-1.20);
\draw[access] (minimum.south) -- (7.65,-1.05) -- (a2.north);
\draw[access] (memory.south) -- (13.1,-1.05) -- (13.5,-1.20);
\end{tikzpicture}
