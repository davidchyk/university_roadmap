\begin{tikzpicture}[
  font=\small,
  task/.style={draw,fill=yellow!12,trapezium,trapezium left angle=82,
    trapezium right angle=98,minimum width=3.2cm,minimum height=1.45cm,align=center},
  monitor/.style={draw,fill=blue!7,minimum width=6.2cm,minimum height=5.6cm,align=center},
  method/.style={draw,rounded corners,fill=green!12,minimum width=3.7cm,
    minimum height=0.55cm,align=center,font=\scriptsize},
  arrow/.style={-Latex,thick},
  both/.style={<->,>=Latex,thick}
]
  \node[task] (t1) at (-7.0, 2.4) {$T_1$\\введення $MM,B,MX$\\обчислення $U_{J_0},MC_{:,J_0},b_1,A_{J_0}$};
  \node[task] (t2) at (-7.0,-2.4) {$T_2$\\без введення\\обчислення $U_{J_1},MC_{:,J_1},b_2,A_{J_1}$};
  \node[task] (t3) at ( 7.0, 2.4) {$T_3$\\введення $p$\\обчислення $U_{J_2},MC_{:,J_2},b_3,A_{J_2}$};
  \node[task] (t4) at ( 7.0,-2.4) {$T_4$\\введення $Z,MT,d$; $\operatorname{sort}(U)$\\обчислення $U_{J_3},MC_{:,J_3},b_4,A_{J_3}$\\виведення $A$};

  \node[monitor] (mon) at (0,0) {};
  \node[font=\bfseries] at (0,2.45) {Монітор \texttt{Monitor}};
  \node[align=center,font=\scriptsize] at (0,1.85)
    {$inputCount=0$, $intermediateCount=0$,\\$sortFinished=false$, $calculationCount=0$, $b=0$};

  \node[method] (input) at (0,1.05) {\texttt{inputT1(), inputT3(), inputT4()}};
  \node[method] (wi) at (0,0.35) {\texttt{signalInput(), waitInput()}};
  \node[method] (bi) at (0,-0.35) {\texttt{addPartialBAndSignal(),}\\\texttt{waitIntermediateAndCopyB()}};
  \node[method] (sort) at (0,-1.15) {\texttt{signalSortFinished(),}\\\texttt{waitSortFinished()}};
  \node[method] (out) at (0,-1.95) {\texttt{signalCalculationFinished(),}\\\texttt{waitOtherCalculations(), printResult()}};

  \draw[both] (t1.east) -- (mon.west |- t1.east);
  \draw[both] (t2.east) -- (mon.west |- t2.east);
  \draw[both] (t3.west) -- (mon.east |- t3.west);
  \draw[both] (t4.west) -- (mon.east |- t4.west);

  \node[draw,fit=(t1)(t2)(t3)(t4)(mon),inner sep=0.35cm,
    label={[font=\bfseries]above:Спільна пам’ять і монітор взаємодії}] {};
\end{tikzpicture}
