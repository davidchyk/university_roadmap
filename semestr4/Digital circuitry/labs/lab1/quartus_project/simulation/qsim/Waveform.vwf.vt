// *****************************************************************************
// This file contains a Verilog test bench with test vectors .The test vectors  
// are exported from a vector file in the Quartus Waveform Editor and apply to  
// the top level entity of the current Quartus project .The user can use this   
// testbench to simulate his design using a third-party simulation tool .       
// *****************************************************************************
// Generated on "02/27/2026 23:32:31"
                                                                        
// Verilog Self-Checking Test Bench (with test vectors) for design :    DavydchukArtem_IO41_lab1
// 
// Simulation tool : 3rd Party
// 

`timescale 1 ps/ 1 ps
module DavydchukArtem_IO41_lab1_vlg_sample_tst(
	X1,
	X2,
	X3,
	sampler_tx
);
input  X1;
input  X2;
input  X3;
output sampler_tx;

reg sample;
time current_time;
always @(X1 or X2 or X3)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

module DavydchukArtem_IO41_lab1_vlg_check_tst (
	F4,
	sampler_rx
);
input  F4;
input sampler_rx;

reg  F4_expected;

reg  F4_prev;

reg  F4_expected_prev;

reg  last_F4_exp;

reg trigger;

integer i;
integer nummismatches;

reg [1:1] on_first_change ;


initial
begin
trigger = 0;
i = 0;
nummismatches = 0;
on_first_change = 1'b1;
end

// update real /o prevs

always @(trigger)
begin
	F4_prev = F4;
end

// update expected /o prevs

always @(trigger)
begin
	F4_expected_prev = F4_expected;
end



// expected F4
initial
begin
	F4_expected = 1'bX;
	F4_expected = #79000 1'b0;
end 
// generate trigger
always @(F4_expected or F4)
begin
	trigger <= ~trigger;
end

always @(posedge sampler_rx or negedge sampler_rx)
begin
`ifdef debug_tbench
	$display("Scanning pattern %d @time = %t",i,$realtime );
	i = i + 1;
	$display("| expected F4 = %b | ",F4_expected_prev);
	$display("| real F4 = %b | ",F4_prev);
`endif
	if (
		( F4_expected_prev !== 1'bx ) && ( F4_prev !== F4_expected_prev )
		&& ((F4_expected_prev !== last_F4_exp) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port F4 :: @time = %t",  $realtime);
		$display ("     Expected value = %b", F4_expected_prev);
		$display ("     Real value = %b", F4_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_F4_exp = F4_expected_prev;
	end

	trigger <= ~trigger;
end
initial 

begin 
$timeformat(-12,3," ps",6);
#90000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module DavydchukArtem_IO41_lab1_vlg_vec_tst();
// constants                                           
// general purpose registers
reg X1;
reg X2;
reg X3;
// wires                                               
wire F4;

wire sampler;                             

// assign statements (if any)                          
DavydchukArtem_IO41_lab1 i1 (
// port map - connection between master ports and signals/registers   
	.F4(F4),
	.X1(X1),
	.X2(X2),
	.X3(X3)
);

// X1
initial
begin
	repeat(4)
	begin
		X1 = 1'b0;
		X1 = #10000 1'b1;
		# 10000;
	end
	X1 = 1'b0;
end 

// X2
initial
begin
	repeat(2)
	begin
		X2 = 1'b0;
		X2 = #20000 1'b1;
		# 20000;
	end
	X2 = 1'b0;
end 

// X3
initial
begin
	X3 = 1'b0;
	X3 = #40000 1'b1;
	X3 = #40000 1'b0;
end 

DavydchukArtem_IO41_lab1_vlg_sample_tst tb_sample (
	.X1(X1),
	.X2(X2),
	.X3(X3),
	.sampler_tx(sampler)
);

DavydchukArtem_IO41_lab1_vlg_check_tst tb_out(
	.F4(F4),
	.sampler_rx(sampler)
);
endmodule

